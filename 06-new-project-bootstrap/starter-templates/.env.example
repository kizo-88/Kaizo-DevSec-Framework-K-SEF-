# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT SENSITIVE PRODUCTION VALUES TO THIS FILE!
# Copy this file to .env or .env.local and fill in your actual credentials.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000

# Database Connection (Bind to localhost or private VPC)
DATABASE_URL=postgresql://app_user:change_me_in_local_env@127.0.0.1:5432/kaizo_dev_db?sslmode=prefer

# Cryptographic Secrets (Must be at least 32 random characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_super_strong_random_secret_string_32_chars_min
SESSION_SECRET=replace_with_another_strong_random_session_secret_32_chars

# CORS Whitelist (Comma-separated trusted origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis Cache (Optional)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
