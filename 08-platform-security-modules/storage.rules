rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSafeImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isSafeDocument() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|zip)');
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public Profile Avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isSafeImage();
    }

    // Private User Vault (PDFs & Documents)
    match /user_vault/{userId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && (isSafeImage() || isSafeDocument());
    }
  }
}
